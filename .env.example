# ============================================================================
# Kaspa Mission Control — environment configuration
# Copy to `.env` and fill in. NEVER commit real keys. TESTNET ONLY.
# ============================================================================

# ---- Ledger backend selection ----------------------------------------------
# "mock"  = in-memory, deterministic, works fully offline (default for dev/demo safety)
# "kaspa" = real Kaspa testnet-10 commitments (requires the vars below + a funded key)
LEDGER="mock"

# ---- Kaspa (TESTNET ONLY) ---------------------------------------------------
# Network id. Do NOT set this to mainnet — the app refuses mainnet by design.
KASPA_NETWORK="testnet-10"

# Optional explicit node URL. Leave empty to use the public community Resolver.
# KASPA_RPC_URL=""

# Testnet spending key for publishing commitments. Provide ONE of the two.
# Fund the derived kaspatest: address from the faucet: https://faucet-tn10.kaspanet.io
# A raw BIP340 private key (hex):
KASPA_PRIVATE_KEY=""
# ...OR a BIP39 mnemonic (derivation m/44'/111111'/0'/0/0):
# KASPA_MNEMONIC=""

# Community REST indexer base URL (used to read back commitment history + payloads).
KASPA_REST_URL="https://api-tn10.kaspa.org"

# Explorer base URL for building clickable txid links in the UI.
KASPA_EXPLORER_URL="https://explorer-tn10.kaspa.org"

# ---- Venice.ai (LLM via Mastra model router, OpenAI-compatible) -------------
VENICE_API_KEY=""
VENICE_BASE_URL="https://api.venice.ai/api/v1"
# Uncensored model used for the offensive-security demo (authorized target only).
VENICE_MODEL="venice-uncensored"

# ---- Local storage (reconstructible index + Mastra workflow state) ----------
# libsql file URLs. Defaults are fine; the DBs are rebuildable from the chain.
LEDGER_DB_URL="file:./.data/ledger.db"
MASTRA_DB_URL="file:./.data/mastra.db"

# ---- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LOG_LEVEL="info"
