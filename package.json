{
  "name": "kaspa-mission-control",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "hello:mission": "tsx --env-file=.env scripts/hello-mission.ts",
    "ledger:demo": "tsx --env-file=.env scripts/ledger-demo.ts",
    "run-mission": "tsx --env-file=.env scripts/run-mission.ts",
    "keygen": "tsx scripts/kaspa-keygen.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.0",
    "@mastra/core": "1.49.0",
    "@mastra/libsql": "1.15.0",
    "@mastra/loggers": "1.2.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.0.0",
    "kaspa-wasm": "file:vendor/kaspa-wasm",
    "lucide-react": "^0.550.0",
    "next": "16.2.6",
    "pino": "^10.3.1",
    "recharts": "^3.0.0",
    "uuid": "^14.0.0",
    "websocket": "^1.0.35",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/websocket": "^1.0.10",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
